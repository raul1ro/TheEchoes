<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- Fonts -->
    <Font name="TheEchoesFontWhite" inherits="SystemFont_Shadow_Med1" virtual="true">
        <Color r="1" g="1" b="1"/>
    </Font>
    <Font name="TheEchoesFontBlue" inherits="SystemFont_Shadow_Med1" virtual="true">
        <Color r="0" g="0.70" b="1"/>
    </Font>

    <!-- Frame with corners and close button -->
    <Frame name="TheEchoesFrameCornersCloseTemplate" parent="" virtual="true" toplevel="true" frameLevel="1000" frameStrata="HIGH" enableMouse="true">
        <!-- BACKGROUND -->
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background"><Color r="0.1" g="0.1" b="0.1" a="1"/></Texture>
            </Layer>
        </Layers>
        <!-- BORDER -->
        <Frames>
            <Frame parentKey="Border" setAllPoints="true" frameLevel="1001">
                <Layers>
                    <!-- CORNERS -->
                    <Layer level="BORDER">
                        <Texture parentKey="TopLeftCorner" atlas="ForgeBorder-CornerBottomRight" useAtlasSize="false">
                            <Size x="40" y="40" />
                            <Anchors>
                                <Anchor point="TOPLEFT" x="-7" y="7" />
                            </Anchors>
                            <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                        </Texture>
                        <Texture parentKey="TopRightCorner" atlas="ForgeBorder-CornerTopRight" useAtlasSize="false">
                            <Size x="40" y="40" />
                            <Anchors>
                                <Anchor point="TOPRIGHT" x="7" y="7" />
                            </Anchors>
                        </Texture>
                        <Texture parentKey="BottomRightCorner" atlas="ForgeBorder-CornerBottomRight" useAtlasSize="false">
                            <Size x="40" y="40" />
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="7" y="-7" />
                            </Anchors>
                        </Texture>
                        <Texture parentKey="BottomLeftCorner" atlas="ForgeBorder-CornerBottomLeft" useAtlasSize="false">
                            <Size x="40" y="40" />
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="-7" y="-7" />
                            </Anchors>
                        </Texture>
                    </Layer>
                    <!-- BORDERS -->
                    <Layer level="BORDER">
                        <Texture parentKey="TopBorder" atlas="_ForgeBorder-Top" useAtlasSize="false">
                            <Size y="10" />
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent.TopLeftCorner" relativePoint="TOPRIGHT"/>
                                <Anchor point="TOPRIGHT" relativeKey="$parent.TopRightCorner" relativePoint="TOPLEFT"/>
                            </Anchors>
                        </Texture>
                        <Texture parentKey="RightBorder" atlas="!ForgeBorder-Right" useAtlasSize="false">
                            <Size x="10" />
                            <Anchors>
                                <Anchor point="TOPRIGHT" relativeKey="$parent.TopRightCorner" relativePoint="BOTTOMRIGHT"/>
                                <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRightCorner" relativePoint="TOPRIGHT"/>
                            </Anchors>
                        </Texture>
                        <Texture parentKey="BottomBorder" atlas="_ForgeBorder-Top" useAtlasSize="false">
                            <Size y="10" />
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomLeftCorner" relativePoint="BOTTOMRIGHT"/>
                                <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRightCorner" relativePoint="BOTTOMLEFT"/>
                            </Anchors>
                            <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                        </Texture>
                        <Texture parentKey="LeftBorder" atlas="!ForgeBorder-Right" useAtlasSize="false">
                            <Size x="10" />
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent.TopLeftCorner" relativePoint="BOTTOMLEFT"/>
                                <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomLeftCorner" relativePoint="TOPLEFT"/>
                            </Anchors>
                            <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="CloseButton" inherits="UIPanelCloseButtonNoScripts" frameLevel="1002">
                <Size x="21" y="21"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.Border.TopRightCorner" x="-2" y="-3"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        self:GetDisabledTexture():SetDesaturated(true)
                        self:GetNormalTexture():SetDesaturated(true)
                        self:GetHighlightTexture():SetDesaturated(true)
                        self:GetPushedTexture():SetDesaturated(true)
                    </OnLoad>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- Frame with corners -->
    <Frame name="TheEchoesFrameCornersTemplate" parent="" virtual="true" toplevel="true" frameLevel="1000" frameStrata="HIGH" enableMouse="true">
        <Frames>
            <Frame parentKey="Corner" setAllPoints="true">
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="7">
                        <Texture parentKey="TopLeft" atlas="ForgeBorder-CornerBottomRight">
                            <Size x="32" y="32" />
                            <Anchors><Anchor point="TOPLEFT" x="-5" y="6" /></Anchors>
                            <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                        </Texture>
                        <Texture parentKey="TopRight" atlas="ForgeBorder-CornerBottomLeft">
                            <Size x="32" y="32" />
                            <Anchors><Anchor point="TOPRIGHT" x="5" y="6" /></Anchors>
                            <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                        </Texture>
                        <Texture parentKey="BottomRight" atlas="ForgeBorder-CornerBottomRight">
                            <Size x="32" y="32" />
                            <Anchors><Anchor point="BOTTOMRIGHT" x="5" y="-5" /></Anchors>
                        </Texture>
                        <Texture parentKey="BottomLeft" atlas="ForgeBorder-CornerBottomLeft">
                            <Size x="32" y="32" />
                            <Anchors><Anchor point="BOTTOMLEFT" x="-5" y="-5" /></Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnLoad>
                        -- Force this frame to stay on top of the parent's children
                        self:SetFrameLevel(self:GetParent():GetFrameLevel() + 10);
                    </OnLoad>
                </Scripts>
            </Frame>
        </Frames>
        <Layers>
            <!-- BACKGROUND -->
            <Layer level="BACKGROUND" textureSubLevel="0">
                <Texture parentKey="Background">
                    <Color r="0.1" g="0.1" b="0.1" a="1"/>
                    <Anchors><Anchor point="LEFT"/><Anchor point="RIGHT"/><Anchor point="BOTTOM"/><Anchor point="TOP"/></Anchors>
                </Texture>
            </Layer>
            <!-- BORDERS -->
            <Layer level="BORDER" textureSubLevel="0">
                <Texture parentKey="TopBorder" atlas="_ForgeBorder-Top" useAtlasSize="false">
                    <Size y="8" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Corner.TopLeft" relativePoint="TOPRIGHT"/>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.Corner.TopRight" relativePoint="TOPLEFT"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="RightBorder" atlas="!ForgeBorder-Right" useAtlasSize="false">
                    <Size x="8" />
                    <Anchors>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.Corner.TopRight" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Corner.BottomRight" relativePoint="TOPRIGHT"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="BottomBorder" atlas="_ForgeBorder-Top" useAtlasSize="false">
                    <Size y="8" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.Corner.BottomLeft" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Corner.BottomRight" relativePoint="BOTTOMLEFT"/>
                    </Anchors>
                    <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                </Texture>
                <Texture parentKey="LeftBorder" atlas="!ForgeBorder-Right" useAtlasSize="false">
                    <Size x="8" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Corner.TopLeft" relativePoint="BOTTOMLEFT"/>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.Corner.BottomLeft" relativePoint="TOPLEFT"/>
                    </Anchors>
                    <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <!-- Frame without corners and close -->
    <Frame name="TheEchoesFrameSimpleTemplate" parent="" virtual="true" toplevel="true" frameLevel="1000" frameStrata="HIGH" enableMouse="true">
        <Layers>
            <!-- BACKGROUND -->
            <Layer level="ARTWORK" textureSubLevel="0">
                <Texture parentKey="Background">
                    <Color r="0.1" g="0.1" b="0.1" a="1"/>
                    <Anchors><Anchor point="LEFT"/><Anchor point="RIGHT"/><Anchor point="BOTTOM"/><Anchor point="TOP"/></Anchors>
                </Texture>
            </Layer>
            <!-- CORNERS -->
            <Layer level="BORDER" textureSubLevel="0">
                <Texture parentKey="TopLeftCorner" atlas="ForgeBorder-CornerBottomRight" useAtlasSize="false">
                    <Size x="32" y="32" />
                    <Anchors><Anchor point="TOPLEFT" x="-5" y="6" /></Anchors>
                    <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                </Texture>
                <Texture parentKey="TopRightCorner" atlas="ForgeBorder-CornerBottomLeft" useAtlasSize="false">
                    <Size x="32" y="32" />
                    <Anchors><Anchor point="TOPRIGHT" x="5" y="6" /></Anchors>
                    <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                </Texture>
                <Texture parentKey="BottomRightCorner" atlas="ForgeBorder-CornerBottomRight" useAtlasSize="false">
                    <Size x="32" y="32" />
                    <Anchors><Anchor point="BOTTOMRIGHT" x="5" y="-5" /></Anchors>
                </Texture>
                <Texture parentKey="BottomLeftCorner" atlas="ForgeBorder-CornerBottomLeft" useAtlasSize="false">
                    <Size x="32" y="32" />
                    <Anchors><Anchor point="BOTTOMLEFT" x="-5" y="-5" /></Anchors>
                </Texture>
            </Layer>
            <!-- BORDERS -->
            <Layer level="BORDER" textureSubLevel="0">
                <Texture parentKey="TopBorder" atlas="_ForgeBorder-Top" useAtlasSize="false">
                    <Size y="8" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.TopLeftCorner" relativePoint="TOPRIGHT"/>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.TopRightCorner" relativePoint="TOPLEFT"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="RightBorder" atlas="!ForgeBorder-Right" useAtlasSize="false">
                    <Size x="8" />
                    <Anchors>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.TopRightCorner" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRightCorner" relativePoint="TOPRIGHT"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="BottomBorder" atlas="_ForgeBorder-Top" useAtlasSize="false">
                    <Size y="8" />
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomLeftCorner" relativePoint="BOTTOMRIGHT"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRightCorner" relativePoint="BOTTOMLEFT"/>
                    </Anchors>
                    <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                </Texture>
                <Texture parentKey="LeftBorder" atlas="!ForgeBorder-Right" useAtlasSize="false">
                    <Size x="8" />
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.TopLeftCorner" relativePoint="BOTTOMLEFT"/>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.BottomLeftCorner" relativePoint="TOPLEFT"/>
                    </Anchors>
                    <TexCoords left="1.0" right="0.0" top="1.0" bottom="0.0"/>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <!-- Input template -->
    <EditBox name="TheEchoesInputTemplate" parent="" virtual="true" frameLevel="1002">
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-1">
                <Texture parentKey="Background"><Color r="0.06" g="0.06" b="0.06" a="1"/></Texture>
            </Layer>
            <Layer level="BORDER" textureSubLevel="1">
                <Texture><Size y="1"/><Color r="0.4" g="0.4" b="0.4" a="1"/><Anchors><Anchor point="TOPLEFT"/><Anchor point="TOPRIGHT"/></Anchors></Texture>
                <Texture><Size x="1"/><Color r="0.4" g="0.4" b="0.4" a="1"/><Anchors><Anchor point="TOPRIGHT"/><Anchor point="BOTTOMRIGHT"/></Anchors></Texture>
                <Texture><Size x="1"/><Color r="0.4" g="0.4" b="0.4" a="1"/><Anchors><Anchor point="BOTTOMRIGHT"/><Anchor point="BOTTOMLEFT"/></Anchors></Texture>
                <Texture><Size x="1"/><Color r="0.4" g="0.4" b="0.4" a="1"/><Anchors><Anchor point="BOTTOMLEFT"/><Anchor point="TOPLEFT"/></Anchors></Texture>
            </Layer>
        </Layers>
        <FontString inherits="TheEchoesFontWhite"/>
        <TextInsets>
            <AbsInset left="2" right="2" top="0" bottom="0" />
        </TextInsets>
    </EditBox>

    <!-- Input template -->
    <EditBox name="TheEchoesInputArrowsTemplate" parent="" virtual="true" frameLevel="1002">
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-1">
                <Texture parentKey="Background"><Color r="0.06" g="0.06" b="0.06" a="1"/></Texture>
            </Layer>
            <Layer level="BORDER" textureSubLevel="1">
                <Texture><Size y="1"/><Color r="0.4" g="0.4" b="0.4" a="1"/><Anchors><Anchor point="TOPLEFT"/><Anchor point="TOPRIGHT"/></Anchors></Texture>
                <Texture><Size x="1"/><Color r="0.4" g="0.4" b="0.4" a="1"/><Anchors><Anchor point="TOPRIGHT"/><Anchor point="BOTTOMRIGHT"/></Anchors></Texture>
                <Texture><Size x="1"/><Color r="0.4" g="0.4" b="0.4" a="1"/><Anchors><Anchor point="BOTTOMRIGHT"/><Anchor point="BOTTOMLEFT"/></Anchors></Texture>
                <Texture><Size x="1"/><Color r="0.4" g="0.4" b="0.4" a="1"/><Anchors><Anchor point="BOTTOMLEFT"/><Anchor point="TOPLEFT"/></Anchors></Texture>
            </Layer>
        </Layers>
        <FontString inherits="TheEchoesFontWhite"/>
        <TextInsets>
            <AbsInset left="2" right="2" top="0" bottom="0" />
        </TextInsets>
        <Frames>
            <Button parentKey="IncrementButton" inherits="TheEchoesBlankButton">
                <Layers>
                    <Layer level="ARTWORK" textureSubLevel="1">
                        <Texture parentKey="ArrowTexture" file="Interface\Calendar\MoreArrow.PNG" alphaMode="ADD" desaturated="true">
                            <Size x="15" y="10"/>
                            <Anchors><Anchor point="CENTER"/></Anchors>
                            <TexCoords left="0.0" right="0.9375" top="0.625" bottom="0.0"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Size x="13" y="8"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="TOPRIGHT" x="1" y="-1"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local value = self:GetParent():GetText()
                        if tonumber(value) then
                            self:GetParent():SetText(value + 1)
                        end
                    </OnClick>
                    <OnDisable>
                        self.ArrowTexture:SetAlpha(0.5)
                    </OnDisable>
                    <OnEnable>
                        self.ArrowTexture:SetAlpha(1)
                    </OnEnable>
                </Scripts>
            </Button>
            <Button parentKey="DecrementButton" inherits="TheEchoesBlankButton">
                <Layers>
                    <Layer level="ARTWORK" textureSubLevel="1">
                        <Texture parentKey="ArrowTexture" file="Interface\Calendar\MoreArrow.PNG" alphaMode="ADD" desaturated="true">
                            <Size x="15" y="10"/>
                            <Anchors><Anchor point="CENTER"/></Anchors>
                            <TexCoords left="0" right="0.9375" top="0" bottom="0.625"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Size x="13" y="8"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent" relativePoint="BOTTOMRIGHT" x="1" y="1"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local value = self:GetParent():GetText()
                        if tonumber(value) then
                            self:GetParent():SetText(value - 1)
                        end
                    </OnClick>
                    <OnDisable>
                        self.ArrowTexture:SetAlpha(0.5)
                    </OnDisable>
                    <OnEnable>
                        self.ArrowTexture:SetAlpha(1)
                    </OnEnable>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnDisable>
                self.Background:SetColorTexture(0.15, 0.15, 0.15);
                self:SetTextColor(0.7, 0.7, 0.7, 0.7);
                self.IncrementButton:Disable();
                self.DecrementButton:Disable();
            </OnDisable>
            <OnEnable>
                self.Background:SetColorTexture(0.06, 0.06, 0.06);
                self:SetTextColor(1, 1, 1, 1);
                self.IncrementButton:Enable();
                self.DecrementButton:Enable();
            </OnEnable>
        </Scripts>
    </EditBox>

    <!-- Input template -->
    <ScrollFrame name="TheEchoesInputScrollTemplate" inherits="UIPanelScrollFrameTemplate" parent="" virtual="true" frameLevel="1002">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background"><Color r="0.06" g="0.06" b="0.06" a="1"/></Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture parentKey="TopBorder">
                    <Size y="1"/>
                    <Color r="0.4" g="0.4" b="0.4" a="1"/>
                    <Anchors><Anchor point="TOPLEFT" x="-1" y="1"/><Anchor point="TOPRIGHT" x="1" y="1"/></Anchors></Texture>
                <Texture parentKey="RightBorder">
                    <Size x="1"/>
                    <Color r="0.4" g="0.4" b="0.4" a="1"/>
                    <Anchors><Anchor point="TOPRIGHT" x="1" y="1"/><Anchor point="BOTTOMRIGHT" x="1" y="-1"/></Anchors></Texture>
                <Texture parentKey="BottomBorder">
                    <Size x="1"/>
                    <Color r="0.4" g="0.4" b="0.4" a="1"/>
                    <Anchors><Anchor point="BOTTOMRIGHT" x="1" y="-1"/><Anchor point="BOTTOMLEFT" x="-1" y="-1"/></Anchors></Texture>
                <Texture parentKey="LeftBorder">
                    <Size x="1"/>
                    <Color r="0.4" g="0.4" b="0.4" a="1"/>
                    <Anchors><Anchor point="BOTTOMLEFT" x="-1" y="-1"/><Anchor point="TOPLEFT" x="-1" y="1"/></Anchors></Texture>
            </Layer>
        </Layers>
        <ScrollChild>
            <EditBox multiLine="true">
                <Size y="1"/>
                <FontString inherits="TheEchoesFontWhite"/>
                <TextInsets><AbsInset left="3" right="3" top="5" bottom="5"/></TextInsets>
                <Scripts>
                    <OnShow>
                        self:SetWidth(self:GetParent():GetWidth())
                    </OnShow>
                </Scripts>
            </EditBox>
        </ScrollChild>
    </ScrollFrame>

    <!-- Simple frame with white-transparent background -->
    <Frame name="TheEchoesWhiteBackground" parent="" virtual="true" enableMouse="true">
        <!-- BACKGROUND -->
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-1">
                <Texture parentKey="Background">
                    <Color r="0.4" g="0.4" b="0.4" a="0.25"/>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <!-- MemberRow -->
    <Frame name="TheEchoesMemberRow" parent="" virtual="true">
        <!-- BACKGROUND -->
        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-1">
                <Texture parentKey="Background">
                    <Color r="0" g="0" b="0" a="0"/>
                </Texture>
            </Layer>
        </Layers>
        <!-- name -->
        <Frames>
            <Frame parentKey="Name" frameLevel="1003">
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="1">
                        <Texture parentKey="Icon">
                            <Size x="18" y="18"/>
                            <Anchors><Anchor point="LEFT" x="-1" y="0"/></Anchors>
                        </Texture>
                        <FontString parentKey="Text" inherits="TheEchoesFontWhite" justifyH="LEFT">
                            <Anchors><Anchor point="LEFT" x="20"/></Anchors>
                        </FontString>
                    </Layer>
                    <Layer level="BORDER" textureSubLevel="0">
                        <Texture parentKey="Border" file="Interface\CharacterFrame\TempPortraitAlphaMaskSmall">
                            <Size x="20" y="20"/>
                            <Color r="0.4" g="0.4" b="0.4" a="0.5"/>
                            <Anchors><Anchor point="CENTER" relativeKey="$parent.Icon" relativePoint="CENTER" x="0" y="0"/></Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
        <!-- roles -->
        <Layers>
            <Layer level="OVERLAY" textureSubLevel="2">
                <FontString parentKey="Tank" inherits="TheEchoesFontWhite" justifyH="LEFT"/>
                <FontString parentKey="Heal" inherits="TheEchoesFontWhite" justifyH="LEFT"/>
                <FontString parentKey="DPS" inherits="TheEchoesFontWhite" justifyH="LEFT"/>
            </Layer>
        </Layers>
        <!-- edit -->
        <Frames>
            <Button parentKey="Edit" inherits="TheEchoesButtonDesaturatedTemplate">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Icon" file="Interface\Buttons\UI-GuildButton-PublicNote-Up" desaturated="true">
                            <Size x="14" y="14"/>
                            <Anchors><Anchor point="CENTER" y="-1"/> </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
        <!-- type, level, rank -->
        <Layers>
            <Layer>
                <FontString parentKey="Type" inherits="TheEchoesFontWhite" justifyH="LEFT"/>
                <FontString parentKey="Level" inherits="TheEchoesFontWhite" justifyH="LEFT"/>
                <FontString parentKey="Rank" inherits="TheEchoesFontWhite" justifyH="LEFT"/>
            </Layer>
        </Layers>
        <!-- invite, whisper -->
        <Frames>
            <Button parentKey="Invite" inherits="TheEchoesButtonDesaturatedTemplate">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Icon" file="Interface\AddOns\TheEchoes\images\icon-plus" desaturated="true">
                            <Size x="14" y="14"/>
                            <Anchors><Anchor point="CENTER" y="-1"/> </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
            <Button parentKey="Whisper" inherits="TheEchoesButtonDesaturatedTemplate">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Icon" file="Interface\CHATFRAME\UI-ChatWhisperIcon" desaturated="true">
                            <Size x="14" y="14"/>
                            <Anchors><Anchor point="CENTER" y="-1"/> </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
        <!-- zone -->
        <Layers>
            <Layer>
                <FontString parentKey="Zone" inherits="TheEchoesFontWhite" justifyH="LEFT" wordwrap="false"/>
            </Layer>
        </Layers>
        <!-- personal note -->
        <Frames>
            <Button parentKey="PNote" inherits="TheEchoesButtonDesaturatedTemplate">
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Icon" file="Interface\Buttons\UI-GuildButton-OfficerNote-Up" desaturated="true">
                            <Size x="14" y="14"/>
                            <Anchors><Anchor point="CENTER" y="-1"/> </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
    </Frame>

</Ui>