<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <Frame name="TheEchoesDropDownMenu" parent="UIParent" inherits="TheEchoesFrameSimpleTemplate" frameStrata="FULLSCREEN_DIALOG" frameLevel="1005">
        <!-- SCROLL CONTENT -->
        <Frames>
            <ScrollFrame parentKey="Body" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOP" y="-3"/>
                    <Anchor point="LEFT" x="0"/>
                    <Anchor point="RIGHT" x="-21"/>
                    <Anchor point="BOTTOM" y="2"/>
                </Anchors>
                <ScrollChild><Frame parentKey="Content"/></ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>

    <Frame name="TheEchoesDropDownMenuElement" virtual="true" enableMouse="true">
        <Size y="18"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="background" setAllpoints="true">
                    <Color r="0" g="0" b="0" a="0"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="text" inherits="GameFontNormalLeft" setAllpoints="true">
                    <Anchors>
                        <Anchor point="LEFT" x="3"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="1"/>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

</Ui>